{
  "name": "snapform",
  "version": "0.1.0",
  "private": true,
  "description": "A Tally.so-inspired form builder platform",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm -w packages/shared run build && npm -w apps/api run dev",
    "dev:web": "npm -w apps/web run dev",
    "dev:all": "npm -w packages/shared run build && npm -w apps/api run dev & npm -w apps/web run dev",
    "build:web": "npm -w apps/web run build",
    "build": "npm -w packages/shared run build && npm -w apps/api run build",
    "build:render": "npm install && npx prisma generate && npm -w packages/shared run build && npm -w apps/api run build",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc -b",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
